<% const normalizedTitle = String(itemTitle || '').toLowerCase(); %>
<% const tc = allTCs.find(t => t.name.toLowerCase() === normalizedTitle); %>
<% if (tc) { %>
    <%- await createTreasureClassTemplate(tc, allTCs, allRelics) %>
    <%- await createDungeonListTemplate(allDungeons, tc) %>
<% } else { %>
    <p>Treasure Class not found: <%= itemTitle %></p>
<% } %>